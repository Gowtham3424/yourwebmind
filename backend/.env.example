# ==============================================================================
# SearchMind Backend Environment Configuration
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# Vectorize Hindsight Core Configuration
# ------------------------------------------------------------------------------
# Supported providers include: openai, gemini, groq, anthropic, ollama, mistral
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_API_KEY=your_llm_api_key_here
HINDSIGHT_API_LLM_MODEL=gpt-4o-mini
HINDSIGHT_API_LLM_BASE_URL=
# Groq service tier: "on_demand" (required for Groq free/on-demand tier), "flex", or "auto"
HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand
# Disable background consolidation worker for local dev/testing with strict rate limits
HINDSIGHT_API_WORKER_ENABLED=false

# Hindsight Database URL (uses embedded pg0 by default - no Docker needed)
HINDSIGHT_API_DATABASE_URL=pg0

# Hindsight Profile Name for Embedded Daemon
HINDSIGHT_PROFILE=searchmind

# Token Budget Guardrails (prevents 413 Payload Too Large and multi-step 429 on Groq 8k TPM tier)
HINDSIGHT_API_REFLECT_MAX_CONTEXT_TOKENS=2500
HINDSIGHT_API_RECALL_MAX_TOKENS=1200
HINDSIGHT_API_RECALL_CHUNKS_MAX_TOKENS=800
HINDSIGHT_API_REFLECT_SOURCE_FACTS_MAX_TOKENS=1200
HINDSIGHT_API_REFLECT_LLM_MAX_RETRIES=5
HINDSIGHT_API_REFLECT_LLM_INITIAL_BACKOFF=4.0
HINDSIGHT_API_REFLECT_LLM_MAX_BACKOFF=3600.0
